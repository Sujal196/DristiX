# DristiX Environment Configuration (Ignored in Git for security)
#
# WARNING: any variable prefixed with VITE_ is inlined into the client bundle
# and is visible to every user in the browser. Never put a privileged secret
# here. Proxy provider calls through a backend instead.
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_GROQ_API_KEY=your_groq_api_key_here
VITE_SARVAM_API_KEY=your_sarvam_api_key_here
