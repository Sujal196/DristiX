{
  "name": "dristix",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -n web,api -c cyan,magenta \"npm:dev\" \"npm:dev:api\"",
    "dev:api": "npm --prefix server run dev",
    "build": "tsc -b && vite build",
    "build:api": "npm --prefix server run build",
    "lint": "oxlint",
    "preview": "vite preview",
    "db:seed": "npm --prefix server run db:seed",
    "db:shell": "mongosh mongodb://127.0.0.1:27017/dristix"
  },
  "dependencies": {
    "axe-core": "^4.13.0",
    "canvas-confetti": "^1.9.4",
    "katex": "^0.18.7",
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.1.2",
    "oxlint": "^1.81.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
