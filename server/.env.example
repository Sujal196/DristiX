# ── DristiX backend environment ──────────────────────────────────────
# Copy to server/.env and fill in. NEVER commit the real .env.

NODE_ENV=development
PORT=4000

# ── MongoDB ──────────────────────────────────────────────────────────
# Your local MongoDB. MONGODB_DB is a separate logical database, so this never
# touches any of your other local databases.
MONGODB_URI="mongodb://127.0.0.1:27017"
MONGODB_DB="dristix"

# Must be at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated list of allowed browser origins.
CORS_ORIGINS="http://localhost:5173,http://localhost:5174"

# Comma-separated invite codes. Leave EMPTY for open registration in local
# development. Set at least one code in production to lock registration down.
INVITE_CODES=""

# AI provider keys. These now live ONLY on the server and are never sent to the
# browser. Leave a key empty to disable that provider.
GEMINI_API_KEY=""
GROQ_API_KEY=""

# Serve the built frontend from ../dist so the whole app is one deployable unit.
SERVE_STATIC=false
